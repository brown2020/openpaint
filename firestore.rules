rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isProjectOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isCreatingOwnProject() {
      return isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.canvasSize is map
        && request.resource.data.canvasSize.width is int
        && request.resource.data.canvasSize.height is int
        && request.resource.data.canvasSize.width > 0
        && request.resource.data.canvasSize.width <= 4096
        && request.resource.data.canvasSize.height > 0
        && request.resource.data.canvasSize.height <= 4096
        && request.resource.data.layers is list
        && request.resource.data.activeLayerId is string;
    }

    match /projects/{projectId} {
      allow read: if isProjectOwner();

      allow create: if isCreatingOwnProject();

      allow update: if isProjectOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['userId', 'createdAt']);

      allow delete: if isProjectOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
